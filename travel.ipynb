import subprocess
import os
from google.colab import userdata
ngrok.kill()
NGROK_AUTH_TOKEN = userdata.get('NGROK_AUTH_TOKEN')
if not NGROK_AUTH_TOKEN:
    print("Please add your NGROK_AUTH_TOKEN to Colab Secrets.")
else:
    ngrok.set_auth_token(NGROK_AUTH_TOKEN)
    print("Starting Streamlit app...")
    subprocess.Popen(['nohup', 'streamlit', 'run', 'app.py', '--server.port', '8501', '&'], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        import time
        time.sleep(5)
        public_url = ngrok.connect(addr="8501", proto="http")
        print(f"Streamlit App URL: {public_url}")
    except Exception as e:
        print(f"Error creating ngrok tunnel: {e}")
        print("Please ensure you have set your NGROK_AUTH_TOKEN in Colab Secrets.")
